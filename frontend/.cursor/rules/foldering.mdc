│   └── role/
│       ├── [id]/              # Dynamic route
│       │   └── page-detail-role.tsx
│       └── page-role.tsx
```

### Shared Components

```
components/
├── moleculs/
│   └── modal/
│       ├── modal-delete-confirmation.tsx
│       └── modal-sync-working-loc.tsx
```

### Feature Hooks

