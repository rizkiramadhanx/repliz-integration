# Domains (dipakai Traefik labels di docker-compose.yml)
BACKEND_DOMAIN=api.example.com
FRONTEND_DOMAIN=app.example.com

# Runtime
NODE_ENV=production

# Postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=ternak_sosmed

# Backend auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_SECRET_REFRESH=change-me-to-a-long-random-string-too
JWT_EXPIRES_IN_REFRESH=7d

# Mailer (opsional)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Alert status koneksi akun (opsional)
# Email tujuan notifikasi saat ada akun (IG/FB/Twitter/dll) yang terputus
# koneksinya, dan tujuan tombol "Kirim Status" di halaman Account.
# Butuh MAIL_* di atas terisi. Kalau kosong, alert di-skip otomatis
# (tetap dicatat ke log).
ALERT_TARGET_EMAIL=

# Repliz API (https://docs.repliz.com) — Dashboard > Settings > API
REPLIZ_BASE_URL=https://api.repliz.com
REPLIZ_ACCESS_KEY=
REPLIZ_SECRET_KEY=
