# Domains (dipakai Traefik labels di docker-compose.yml)
BACKEND_DOMAIN=api.example.com
FRONTEND_DOMAIN=app.example.com

# Runtime
NODE_ENV=production

# Postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=ternak_sosmed

# Backend auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_SECRET_REFRESH=change-me-to-a-long-random-string-too
JWT_EXPIRES_IN_REFRESH=7d

# Mailer (opsional)
MAIL_HOST=
# 465 = SSL/TLS implisit (MAIL_SECURE=true), 587 = STARTTLS (MAIL_SECURE=false)
MAIL_PORT=465
# Opsional — kalau kosong, otomatis true untuk port 465 dan false selainnya
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Nama pengirim yang tampil di inbox. Kosong = "No Reply"
MAIL_FROM_NAME=

# Alert status koneksi akun (opsional)
# Email tujuan notifikasi saat ada akun (IG/FB/Twitter/dll) yang terputus
# koneksinya, dan tujuan tombol "Kirim Status" di halaman Account.
# Butuh MAIL_* di atas terisi. Kalau kosong, alert di-skip otomatis
# (tetap dicatat ke log).
ALERT_TARGET_EMAIL=

# Repliz API (https://docs.repliz.com) — Dashboard > Settings > API
REPLIZ_BASE_URL=https://api.repliz.com
REPLIZ_ACCESS_KEY=
REPLIZ_SECRET_KEY=

# OPSIONAL. URL publik backend untuk link media yang diunduh server Repliz.
# Biarkan kosong — nilainya otomatis https://${BACKEND_DOMAIN}. Isi HANYA
# kalau domainnya berbeda, mis. memakai tunnel saat pengembangan.
# Jangan tulis port pada URL https: TLS ada di 443 lewat Traefik.
# PUBLIC_BASE_URL=
