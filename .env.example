# Domains (dipakai Traefik labels di docker-compose.yml)
BACKEND_DOMAIN=api.example.com
FRONTEND_DOMAIN=app.example.com

# Runtime
NODE_ENV=production

# Postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=ternak_sosmed

# Backend auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_SECRET_REFRESH=change-me-to-a-long-random-string-too
JWT_EXPIRES_IN_REFRESH=7d

# Mailer (opsional)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# WhatsApp alerting (opsional) — gateway go-whatsapp-web-multidevice
# https://github.com/aldinokemal/go-whatsapp-web-multidevice
# Dipakai untuk kirim notifikasi WA saat ada akun (IG/FB/Twitter/dll) yang
# terputus koneksinya. Tanpa WA_BASE_URL & WA_ALERT_TARGET_PHONE, alert
# di-skip otomatis (tetap dicatat ke log).
WA_BASE_URL=
WA_BASIC_AUTH_USER=
WA_BASIC_AUTH_PASS=
WA_DEVICE_ID=
WA_ALERT_TARGET_PHONE=
