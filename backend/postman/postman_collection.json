            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manager Updated\",\n  \"actions\": [\"event:read\", \"event:update\", \"event_category:read\", \"registration_event:create\"]\n}"
            },
            "url": { "raw": "{{base_url}}/api/role/1", "host": ["{{base_url}}"], "path": ["api", "role", "1"] },
            "description": "Permission: role:update. Role Admin tidak boleh di-update."
          }
        },
        {
          "name": "Delete Role",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/role/2", "host": ["{{base_url}}"], "path": ["api", "role", "2"] },
            "description": "Permission: role:delete. Role Admin tidak boleh dihapus."
          }
        }
